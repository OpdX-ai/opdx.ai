---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CountdownIsland from '../components/CountdownIsland';
import EmailForm from '../components/EmailForm';
import CalendarLinks from '../components/CalendarLinks.astro';
import { CONFIG } from '../lib/config';
import '../styles/home.css';
---

<BaseLayout>
  <Header />
  
  <main class="hero-section">
    <div class="container">
      <div class="hero-content">
        <h2 class="hero-headline">{CONFIG.headline}</h2>
        <p class="hero-subheadline">{CONFIG.subHeadline}</p>
        
        <CountdownIsland 
          client:load
          label={CONFIG.countdownLabel}
          launchReady={CONFIG.LAUNCH_READY}
        />
        
        {CONFIG.ENABLE_WAITLIST && (
          <div class="cta-section">
            <EmailForm
              client:load
              turnstileSiteKey={CONFIG.turnstileSiteKey}
              primaryCta={CONFIG.ctaPrimary}
              successMessage={CONFIG.ctaSuccess}
            />
            <CalendarLinks />
          </div>
        )}
      </div>
    </div>
  </main>
  
  <section class="features-section">
    <div class="container">
      <div class="features-grid">
        <div class="feature-item">
          <h3 class="feature-title">Appointment Booking</h3>
          <p class="feature-description">Streamline scheduling with automated booking and patient management.</p>
        </div>
        <div class="feature-item">
          <h3 class="feature-title">Patient Records</h3>
          <p class="feature-description">Secure, digital patient records accessible anytime, anywhere.</p>
        </div>
        <div class="feature-item">
          <h3 class="feature-title">Payment Processing</h3>
          <p class="feature-description">Integrated payment solutions for seamless transactions.</p>
        </div>
        <div class="feature-item">
          <h3 class="feature-title">OPD Operations</h3>
          <p class="feature-description">Complete OPD management to reduce administrative burden.</p>
        </div>
      </div>
    </div>
  </section>
  
  <Footer />
</BaseLayout>

