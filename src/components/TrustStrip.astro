---
interface Props {
  points: string[];
}

const { points } = Astro.props;
---

<section class="trust-strip" aria-labelledby="trust-heading">
  <h2 id="trust-heading" class="sr-only">Trust, Privacy & Compliance</h2>
  <div class="container">
    <div class="trust-strip__content">
      <h3 class="trust-strip__title">Trust, Privacy & Compliance</h3>
      <ul class="trust-strip__list">
        {points.map((point) => (
          <li class="trust-strip__item">
            <svg class="trust-strip__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>{point}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .trust-strip {
    padding: 4rem 0;
    background: var(--color-paper);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .trust-strip__content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .trust-strip__title {
    font-family: var(--font-headline);
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 2rem;
  }

  .trust-strip__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .trust-strip__item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem;
    background: var(--color-bg);
    border-radius: 8px;
    text-align: left;
  }

  .trust-strip__icon {
    flex-shrink: 0;
    color: var(--color-mint);
    margin-top: 2px;
  }

  .trust-strip__item span {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .trust-strip {
      padding: 3rem 0;
    }

    .trust-strip__title {
      font-size: 1.5rem;
      margin-bottom: 1.5rem;
    }
  }
</style>

